<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Dumbbell bar -->
    <path android:pathData="M14,56 L108,56 L108,66 L14,66 Z" android:strokeWidth="0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14" android:startY="61"
                android:endX="108" android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF1e1e5e"/>
                <item android:offset="0.5" android:color="#FF4040a0"/>
                <item android:offset="1.0" android:color="#FF1e1e5e"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left outer plate -->
    <path android:pathData="M12,44 Q15,44 15,47 L15,75 Q15,78 12,78 L12,78 Q9,78 9,75 L9,47 Q9,44 12,44 Z" android:strokeWidth="0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="9" android:startY="61"
                android:endX="15" android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0d0d2b"/>
                <item android:offset="0.5" android:color="#FF2a2a6e"/>
                <item android:offset="1.0" android:color="#FF0d0d2b"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left inner plate -->
    <path android:pathData="M27,49 Q29,49 29,51 L29,71 Q29,73 27,73 L27,73 Q25,73 25,71 L25,51 Q25,49 27,49 Z"
        android:fillColor="#FF2a2a6e"
        android:strokeWidth="0"/>

    <!-- Right outer plate -->
    <path android:pathData="M108,44 Q111,44 111,47 L111,75 Q111,78 108,78 L108,78 Q105,78 105,75 L105,47 Q105,44 108,44 Z" android:strokeWidth="0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="105" android:startY="61"
                android:endX="111" android:endY="61"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF0d0d2b"/>
                <item android:offset="0.5" android:color="#FF2a2a6e"/>
                <item android:offset="1.0" android:color="#FF0d0d2b"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right inner plate -->
    <path android:pathData="M93,49 Q95,49 95,51 L95,71 Q95,73 93,73 L93,73 Q91,73 91,71 L91,51 Q91,49 93,49 Z"
        android:fillColor="#FF2a2a6e"
        android:strokeWidth="0"/>

    <!-- Glow behind bolt -->
    <path android:pathData="M60,33 Q80,33 80,61 Q80,89 60,89 Q40,89 40,61 Q40,33 60,33 Z"
        android:fillColor="#595b21b6"
        android:strokeWidth="0"/>

    <!-- Bolt -->
    <path android:pathData="M65,18 L48,60 L60,60 L55,102 L74,60 L62,60 Z" android:strokeWidth="0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="60" android:startY="18"
                android:endX="60" android:endY="102"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFffffff"/>
                <item android:offset="0.3" android:color="#FFc4b5fd"/>
                <item android:offset="0.7" android:color="#FF7c3aed"/>
                <item android:offset="1.0" android:color="#FF3a00cc"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bolt highlight -->
    <path android:pathData="M63,25 L52,58 L61,58 L57,90 L68,60 L60,60 Z"
        android:fillColor="#33e0d0ff"
        android:strokeWidth="0"/>

</vector>
